# Development image names.
CODEX_TERMINAL_IMAGE=ghcr.io/shepemer/unraid-addons-codex-terminal:dev
UNRAID_MCP_IMAGE=ghcr.io/shepemer/unraid-addons-unraid-mcp:1.2.4-dev
MEDIA_MCP_IMAGE=ghcr.io/shepemer/unraid-addons-media-mcp:dev
UTILITIES_MCP_IMAGE=ghcr.io/shepemer/unraid-addons-utilities-mcp:dev
ISSUE_AGENT_IMAGE=ghcr.io/shepemer/unraid-addons-media-issue-agent:dev

# SSH and password-protected browser terminal into codex-terminal.
CODEX_SSH_PORT=2222
SSH_AUTHORIZED_KEYS=
SSH_PASSWORD_LOGIN=false
SSH_PASSWORD=
CODEX_WEBUI_PORT=7681
WEBUI_PASSWORD=
AUTO_LAUNCH_CODEX=true
CODEX_WEBUI_BYPASS_APPROVALS=true

# Optional media/download path diagnostics inside codex-terminal. Unraid exposes
# narrow media read-only and downloads read/write mounts as Advanced settings;
# Compose users must add equivalent long bind mounts explicitly. Set path maps
# only after those exact-case host paths are mounted.
CODEX_MEDIA_PATH_MAPS=

# MCP client authentication. Generate independent values with:
# openssl rand -hex 32
UNRAID_MCP_BEARER_TOKEN=
MEDIA_MCP_BEARER_TOKEN=
UTILITIES_MCP_BEARER_TOKEN=

# Unraid GraphQL API. Keep the API key only on the MCP sidecar.
UNRAID_API_URL=http://tower.local/graphql
UNRAID_API_KEY=

# Optional media MCP sidecar. Enable with:
# docker compose --profile media up -d media-mcp
# Direct file access has no default. Use docker-compose.media-paths.yml.example
# only with existing host paths whose capitalization exactly matches Unraid.
MEDIA_MCP_DOWNLOADS_DIR=
MEDIA_MCP_MEDIA_DIR=
MEDIA_MCP_MEDIA_ROOTS=
# Additional nonstandard mappings. /downloads=/mnt/unraid/downloads is built in;
# an explicit /downloads mapping here overrides that one standard mapping.
MEDIA_MCP_PATH_MAPS=

# Configure only the media apps Codex should manage.
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
PLEX_URL=
PLEX_TOKEN=
TAUTULLI_URL=
TAUTULLI_API_KEY=
TRACEARR_URL=
TRACEARR_API_KEY=
THREADFIN_URL=
THREADFIN_USERNAME=
THREADFIN_PASSWORD=
THREADFIN_TOKEN=
BAZARR_URL=
BAZARR_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
NZBGET_URL=
NZBGET_USERNAME=
NZBGET_PASSWORD=
SEERR_URL=
SEERR_API_KEY=

# Optional human-in-the-loop media issue agent. Enable with:
# docker compose --profile issue-agent up -d media-issue-agent
# Populate ./data/media-issue-agent/codex by running Codex login with ChatGPT
# auth inside the container, or by copying a trusted Codex auth cache. Configure
# non-secret runner and operations preferences through the authenticated WebUI.
ISSUE_AGENT_MEDIA_MCP_BEARER_TOKEN=
ISSUE_AGENT_WEBUI_PORT=6983
ISSUE_AGENT_WEB_PASSWORD=
ISSUE_AGENT_PUSHOVER_APP_TOKEN=
ISSUE_AGENT_PUSHOVER_USER_KEY=
ISSUE_AGENT_SLACK_ENABLED=false
ISSUE_AGENT_SLACK_APP_TOKEN=
ISSUE_AGENT_SLACK_BOT_TOKEN=
ISSUE_AGENT_SLACK_CHANNEL_ID=
# Restricted OpenAI Platform key used only for Slack moderation; never passed to
# Codex or media-mcp.
ISSUE_AGENT_OPENAI_MODERATION_API_KEY=

# Optional utilities MCP sidecar. Enable with:
# docker compose --profile utilities up -d utilities-mcp
# Include any reverse-proxy base path directly in this URL.
SCRUTINY_URL=

# Local development bind mounts.
CODEX_CONFIG_DIR=./data/codex-terminal
UNRAID_MCP_STATE_DIR=./data/unraid-mcp/state
UNRAID_MCP_LOG_DIR=./data/unraid-mcp/logs
ISSUE_AGENT_CONFIG_DIR=./data/media-issue-agent
